filters:
  and:
    - file.hasTag("task")
    - file.hasTag("archived") != true
    - cliente == "churrascodaelite"
views:
  - type: tasknotesKanban
    name: Quadro
    groupBy:
      property: status
      direction: ASC
    order:
      - status
      - due
      - file.tags
    sort:
      - property: tasknotes_manual_order
        direction: DESC
    hideEmptyColumns: false
    pinnedColumns: a-fazer, fazendo, aguardando-cliente, feito
    columnWidth: 280
