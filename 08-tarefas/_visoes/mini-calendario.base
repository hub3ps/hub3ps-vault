# Mini Calendar
# Generated with your TaskNotes settings

filters:
  and:
    - file.hasTag("task")
    - file.hasTag("archived") != true

formulas:
  priorityWeight: if(priority=="none",0,if(priority=="low",1,if(priority=="normal",2,if(priority=="high",3,-1))))
  daysUntilDue: if((due.isEmpty() == false), ((number(date(due)) - number(today())) / 86400000).floor(), null)
  dueIn: if(due.isEmpty(), "", if(formula.daysUntilDue == 0, "Hoje", if(formula.daysUntilDue > 0, (if((formula.daysUntilDue) >= 0 && (formula.daysUntilDue) < 2, (if((formula.daysUntilDue) >= 1000 || (formula.daysUntilDue) <= -1000, ("" + (formula.daysUntilDue)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue))) + " dia"), if((formula.daysUntilDue) != 0 && (formula.daysUntilDue) % 1000000 == 0, (if((formula.daysUntilDue) >= 1000 || (formula.daysUntilDue) <= -1000, ("" + (formula.daysUntilDue)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue))) + " dias"), (if((formula.daysUntilDue) >= 1000 || (formula.daysUntilDue) <= -1000, ("" + (formula.daysUntilDue)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue))) + " dias")))), (if((formula.daysUntilDue * -1) >= 0 && (formula.daysUntilDue * -1) < 2, (if((formula.daysUntilDue * -1) >= 1000 || (formula.daysUntilDue * -1) <= -1000, ("" + (formula.daysUntilDue * -1)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue * -1))) + " dia em atraso"), if((formula.daysUntilDue * -1) != 0 && (formula.daysUntilDue * -1) % 1000000 == 0, (if((formula.daysUntilDue * -1) >= 1000 || (formula.daysUntilDue * -1) <= -1000, ("" + (formula.daysUntilDue * -1)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue * -1))) + " dias em atraso"), (if((formula.daysUntilDue * -1) >= 1000 || (formula.daysUntilDue * -1) <= -1000, ("" + (formula.daysUntilDue * -1)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue * -1))) + " dias em atraso")))))))
  daysUntilScheduled: if((scheduled.isEmpty() == false), ((number(date(scheduled)) - number(today())) / 86400000).floor(), null)
  daysSinceCreated: ((number(now()) - number(file.ctime)) / 86400000).floor()
  daysSinceModified: ((number(now()) - number(file.mtime)) / 86400000).floor()
  isOverdue: (due.isEmpty() == false) && date(due) < today() && status != "feito"
  isDueToday: (due.isEmpty() == false) && date(due).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")
  isDueThisWeek: (due.isEmpty() == false) && date(due).format("YYYY-MM-DD") >= today().format("YYYY-MM-DD") && date(due).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD")
  isScheduledToday: (scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")
  isRecurring: recurrence && !recurrence.isEmpty()
  hasTimeEstimate: timeEstimate && timeEstimate > 0
  timeRemaining: if(timeEstimate && timeEstimate > 0, timeEstimate - if(timeEntries, list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0), 0), null)
  efficiencyRatio: if(timeEstimate && timeEstimate > 0 && timeEntries, (list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) / timeEstimate * 100).round(), null)
  timeTrackedThisWeek: if(timeEntries, list(timeEntries).filter(value.endTime && date(value.startTime) >= today() - "7d").map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round(), 0)
  timeTrackedToday: if(timeEntries, list(timeEntries).filter(value.endTime && date(value.startTime).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round(), 0)
  dueMonth: if((due.isEmpty() == false), date(due).format("YYYY-MM"), "Sem data de vencimento")
  dueWeek: if((due.isEmpty() == false), date(due).format("YYYY-[W]WW"), "Sem data de vencimento")
  scheduledMonth: if((scheduled.isEmpty() == false), date(scheduled).format("YYYY-MM"), "Não agendadas")
  scheduledWeek: if((scheduled.isEmpty() == false), date(scheduled).format("YYYY-[W]WW"), "Não agendadas")
  dueDateCategory: if(due.isEmpty(), "Sem data de vencimento", if(date(due) < today(), "Em atraso", if(date(due).format("YYYY-MM-DD") == today().format("YYYY-MM-DD"), "Hoje", if(date(due).format("YYYY-MM-DD") == (today() + "1 day").format("YYYY-MM-DD"), "Amanhã", if(date(due).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD"), "Esta semana", "Mais tarde")))))
  timeEstimateCategory: if(timeEstimate.isEmpty() || timeEstimate == 0, "Sem estimativa", if(timeEstimate < 30, "Rápida (<30min)", if(timeEstimate <= 120, "Média (30min-2h)", "Longa (>2h)")))
  ageCategory: if(((number(now()) - number(file.ctime)) / 86400000) < 1, "Hoje", if(((number(now()) - number(file.ctime)) / 86400000) < 7, "Esta semana", if(((number(now()) - number(file.ctime)) / 86400000) < 30, "Este mês", "Mais antigas")))
  createdMonth: file.ctime.format("YYYY-MM")
  modifiedMonth: file.mtime.format("YYYY-MM")
  priorityCategory: if(priority=="none","None",if(priority=="low","Low",if(priority=="normal","Normal",if(priority=="high","High","No priority"))))
  projectCount: (if((if(projects, list(projects).length, 0)) == 0, ("Nenhum projeto"), if((if(projects, list(projects).length, 0)) == 1, ("Um projeto"), if((if(projects, list(projects).length, 0)) != 0 && (if(projects, list(projects).length, 0)) % 1000000 == 0, ("Vários projetos"), if((if(projects, list(projects).length, 0)) >= 0 && (if(projects, list(projects).length, 0)) < 2, ("Projeto"), ("Vários projetos"))))))
  contextCount: (if((if(contexts, list(contexts).length, 0)) == 0, ("Nenhum contexto"), if((if(contexts, list(contexts).length, 0)) == 1, ("Um contexto"), if((if(contexts, list(contexts).length, 0)) != 0 && (if(contexts, list(contexts).length, 0)) % 1000000 == 0, ("Vários contextos"), if((if(contexts, list(contexts).length, 0)) >= 0 && (if(contexts, list(contexts).length, 0)) < 2, ("Contexto"), ("Vários contextos"))))))
  trackingStatus: if(timeEstimate.isEmpty() || timeEstimate == 0, "Sem estimativa", if(timeEntries.isEmpty(), "Não iniciadas", if(formula.efficiencyRatio < 100, "Abaixo da estimativa", "Acima da estimativa")))
  nextDate: if((due.isEmpty() == false) && (scheduled.isEmpty() == false), if(date(due) < date(scheduled), due, scheduled), if((due.isEmpty() == false), due, scheduled))
  daysUntilNext: if((due.isEmpty() == false) && (scheduled.isEmpty() == false), min(formula.daysUntilDue, formula.daysUntilScheduled), if((due.isEmpty() == false), formula.daysUntilDue, formula.daysUntilScheduled))
  hasDate: (due.isEmpty() == false) || (scheduled.isEmpty() == false)
  isToday: ((due.isEmpty() == false) && date(due).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")) || ((scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") == today().format("YYYY-MM-DD"))
  isThisWeek: ((due.isEmpty() == false) && date(due).format("YYYY-MM-DD") >= today().format("YYYY-MM-DD") && date(due).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD")) || ((scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") >= today().format("YYYY-MM-DD") && date(scheduled).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD"))
  nextDateCategory: if(due.isEmpty() && scheduled.isEmpty(), "Sem data", if(((due.isEmpty() == false) && date(due) < today()) || ((scheduled.isEmpty() == false) && date(scheduled) < today()), "Em atraso/passado", if(((due.isEmpty() == false) && date(due).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")) || ((scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") == today().format("YYYY-MM-DD")), "Hoje", if(((due.isEmpty() == false) && date(due).format("YYYY-MM-DD") == (today() + "1 day").format("YYYY-MM-DD")) || ((scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") == (today() + "1 day").format("YYYY-MM-DD")), "Amanhã", if(((due.isEmpty() == false) && date(due).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD")) || ((scheduled.isEmpty() == false) && date(scheduled).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD")), "Esta semana", "Mais tarde")))))
  nextDateMonth: if((due.isEmpty() == false) && (scheduled.isEmpty() == false), if(date(due) < date(scheduled), date(due).format("YYYY-MM"), date(scheduled).format("YYYY-MM")), if((due.isEmpty() == false), date(due).format("YYYY-MM"), if((scheduled.isEmpty() == false), date(scheduled).format("YYYY-MM"), "Sem data")))
  nextDateWeek: if((due.isEmpty() == false) && (scheduled.isEmpty() == false), if(date(due) < date(scheduled), date(due).format("YYYY-[W]WW"), date(scheduled).format("YYYY-[W]WW")), if((due.isEmpty() == false), date(due).format("YYYY-[W]WW"), if((scheduled.isEmpty() == false), date(scheduled).format("YYYY-[W]WW"), "Sem data")))
  urgencyScore: if(due.isEmpty() && scheduled.isEmpty(), formula.priorityWeight, formula.priorityWeight + max(0, 10 - if(formula.daysUntilNext, formula.daysUntilNext, 0)) + (1 - ((number(date(formula.nextDate)) - number(date(date(formula.nextDate).format("YYYY-MM-DD")))) / 86400000)))
  timeTrackedFormatted: if(timeEntries, if(list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) >= 60, (if(((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) / 60).floor()) >= 1000 || ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) / 60).floor()) <= -1000, ("" + ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) / 60).floor())).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) / 60).floor()))) + "h " + if(((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) % 60).round()) >= 1000 || ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) % 60).round()) <= -1000, ("" + ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) % 60).round())).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + ((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0) % 60).round()))) + "min"), (if((list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round()) >= 1000 || (list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round()) <= -1000, ("" + (list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round())).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (list(timeEntries).filter(value.endTime).map((number(date(value.endTime)) - number(date(value.startTime))) / 60000).reduce(acc + value, 0).round()))) + "min")), (if((0) >= 1000 || (0) <= -1000, ("" + (0)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (0))) + "min"))
  dueDateDisplay: if(due.isEmpty(), "", if(date(due).format("YYYY-MM-DD") == today().format("YYYY-MM-DD"), "Hoje", if(date(due).format("YYYY-MM-DD") == (today() + "1 day").format("YYYY-MM-DD"), "Amanhã", if(date(due).format("YYYY-MM-DD") == (today() - "1 day").format("YYYY-MM-DD"), "Ontem", if(date(due) < today(), (if((formula.daysUntilDue * -1) >= 0 && (formula.daysUntilDue * -1) < 2, ("há " + if((formula.daysUntilDue * -1) >= 1000 || (formula.daysUntilDue * -1) <= -1000, ("" + (formula.daysUntilDue * -1)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue * -1))) + " dia"), if((formula.daysUntilDue * -1) != 0 && (formula.daysUntilDue * -1) % 1000000 == 0, ("há " + if((formula.daysUntilDue * -1) >= 1000 || (formula.daysUntilDue * -1) <= -1000, ("" + (formula.daysUntilDue * -1)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue * -1))) + " dias"), ("há " + if((formula.daysUntilDue * -1) >= 1000 || (formula.daysUntilDue * -1) <= -1000, ("" + (formula.daysUntilDue * -1)).replace(/\B(?=(\d{3})+(?!\d))/g, "."), ("" + (formula.daysUntilDue * -1))) + " dias")))), if(date(due).format("YYYY-MM-DD") <= (today() + "7 days").format("YYYY-MM-DD"), date(due).format("ddd"), date(due).format("MMM D")))))))

views:
  - type: tasknotesMiniCalendar
    name: "Vencimento"
    order:
      - status
      - priority
      - due
      - scheduled
      - projects
      - contexts
      - file.tags
      - blockedBy
      - recurrence
      - complete_instances
      - file.tasks
    sort:
      - property: due
        direction: ASC
    dateProperty: due
  - type: tasknotesMiniCalendar
    name: "Agendadas"
    order: []
    dateProperty: scheduled
  - type: tasknotesMiniCalendar
    name: "Criadas"
    dateProperty: file.ctime
  - type: tasknotesMiniCalendar
    name: "Modificadas"
    dateProperty: file.mtime
